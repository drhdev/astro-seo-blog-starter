---
interface Crumb { name: string; href: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <span aria-hidden="true">/</span>}
        {index === items.length - 1 ? <span class="font-medium text-foreground">{item.name}</span> : <a class="transition hover:text-foreground" href={item.href}>{item.name}</a>}
      </li>
    ))}
  </ol>
</nav>
