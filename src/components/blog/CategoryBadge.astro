---
import { getCategory } from "../../data/categories";
import { getCategoryUrl } from "../../utils/blog";
interface Props { slug: string }
const { slug } = Astro.props;
const category = getCategory(slug);
---
{category && <a href={getCategoryUrl(slug)} class="inline-flex rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-800 ring-1 ring-inset ring-sky-200">{category.name}</a>}
