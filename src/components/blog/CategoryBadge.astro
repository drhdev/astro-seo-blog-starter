---
import { getCategory } from "../../data/categories";
import { getCategoryUrl } from "../../utils/blog";
interface Props { slug: string }
const { slug } = Astro.props;
const category = getCategory(slug);
---
{category && <a href={getCategoryUrl(slug)} class="inline-flex rounded-full border border-border bg-secondary px-3 py-1 text-xs font-medium text-secondary-foreground transition hover:bg-accent hover:text-accent-foreground">{category.name}</a>}
