---
import { Image } from "astro:assets";
interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
}
const { src, alt, loading = "lazy" } = Astro.props;
const className = Astro.props.class ?? "";
---
<Image src={src} alt={alt} loading={loading} class={`aspect-[16/9] w-full rounded-3xl object-cover ${className}`} />
