---
import type { BlogPost } from "../../utils/blog";
import { getPostUrl } from "../../utils/blog";
import CategoryBadge from "./CategoryBadge.astro";
import FeaturedImage from "./FeaturedImage.astro";
interface Props { post: BlogPost }
const { post } = Astro.props;
---
<article class="group overflow-hidden rounded-2xl border border-border bg-card text-card-foreground transition hover:-translate-y-0.5 hover:border-foreground/30">
  <a href={getPostUrl(post)} aria-label={`Artikel lesen: ${post.data.title}`}>
    <FeaturedImage src={post.data.featuredImage} alt={post.data.featuredImageAlt} class="rounded-none border-0 border-b border-border" />
  </a>
  <div class="p-6">
    <div class="flex items-center gap-3">
      <CategoryBadge slug={post.data.category} />
      <time class="text-xs text-muted-foreground" datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString("de-DE")}</time>
    </div>
    <h2 class="mt-4 text-xl font-semibold tracking-tight text-card-foreground">
      <a class="transition hover:text-muted-foreground" href={getPostUrl(post)}>{post.data.title}</a>
    </h2>
    <p class="mt-3 line-clamp-3 text-sm leading-6 text-muted-foreground">{post.data.description}</p>
  </div>
</article>
