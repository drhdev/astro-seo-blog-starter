---
import ButtonLink from "../ui/ButtonLink.astro";
import Container from "../ui/Container.astro";
---
<section class="py-20 sm:py-28">
  <Container>
    <div class="rounded-3xl bg-slate-950 px-6 py-14 text-center text-white sm:px-12">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Forken, anpassen, deployen.</h2>
      <p class="mx-auto mt-4 max-w-2xl text-slate-300">Ändere Design, Inhalte, Kategorien und Domain. Die technische Basis bleibt stabil.</p>
      <div class="mt-8">
        <ButtonLink href="/blog/" variant="secondary">Starter erkunden</ButtonLink>
      </div>
    </div>
  </Container>
</section>
