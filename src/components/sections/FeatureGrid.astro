---
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
const features = [
  { title: "Astro-only", description: "Keine React-Islands, keine Framework-Bundles, statisch und leichtgewichtig." },
  { title: "SEO-ready", description: "Canonicals, Open Graph, Twitter Cards, JSON-LD, Sitemap und RSS sind vorbereitet." },
  { title: "Content-System", description: "Blog, Kategorien, Featured Images, Demo-Posts und typisierte Content Collections." },
  { title: "Docker & Coolify", description: "Multi-stage Dockerfile, unprivileged nginx, Compose und Healthcheck für Coolify." },
  { title: "Tailwind latest", description: "Tailwind über @tailwindcss/vite, ohne deprecated @astrojs/tailwind." },
  { title: "Wiederverwendbar", description: "Prompts, Checklisten und klare Dateien für neue Websites aus demselben Starter." },
];
---
<section class="bg-slate-50 py-20 sm:py-28">
  <Container>
    <SectionHeader eyebrow="Features" title="Alles Nötige für einen sauberen Start" description="Die Basis ist bewusst klein, aber produktionsorientiert und erweiterbar." />
    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <article class="rounded-3xl border border-slate-200 bg-white p-7">
          <h3 class="text-lg font-semibold text-slate-950">{feature.title}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">{feature.description}</p>
        </article>
      ))}
    </div>
  </Container>
</section>
