---
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
const features = [
  { title: "Astro-only", description: "Keine React-Islands, keine Framework-Bundles, statisch und leichtgewichtig." },
  { title: "SEO-ready", description: "Canonicals, Open Graph, Twitter Cards, JSON-LD, Sitemap und RSS sind vorbereitet." },
  { title: "Dark / Light / System", description: "Ein shadcn-inspiriertes Token-System mit System-Default und minimalem Theme-Script." },
  { title: "Docker & Coolify", description: "Multi-stage Dockerfile, unprivileged nginx, Compose und Healthcheck für Coolify." },
  { title: "Tailwind latest", description: "Tailwind über @tailwindcss/vite, ohne deprecated @astrojs/tailwind." },
  { title: "Wiederverwendbar", description: "Prompts, Checklisten und klare Dateien für neue Websites aus demselben Starter." },
];
---
<section class="border-y border-border bg-muted/35 py-20 sm:py-28">
  <Container>
    <SectionHeader eyebrow="Features" title="Alles Nötige für einen sauberen Start" description="Die Basis ist bewusst klein, monochrom, produktionsorientiert und erweiterbar." />
    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <article class="rounded-2xl border border-border bg-card p-7 text-card-foreground transition hover:border-foreground/30">
          <h3 class="text-lg font-semibold text-card-foreground">{feature.title}</h3>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">{feature.description}</p>
        </article>
      ))}
    </div>
  </Container>
</section>
