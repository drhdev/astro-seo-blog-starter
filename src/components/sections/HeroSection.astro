---
import ButtonLink from "../ui/ButtonLink.astro";
import Container from "../ui/Container.astro";
---
<section class="py-20 sm:py-28">
  <Container class="text-center">
    <p class="text-sm font-medium uppercase tracking-[0.25em] text-muted-foreground">Astro SEO Starter</p>
    <h1 class="mx-auto mt-5 max-w-4xl text-4xl font-semibold tracking-tight text-foreground sm:text-6xl lg:text-7xl">
      Ein schneller Starter für auffindbare Astro-Websites.
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
      Astro-only, Tailwind, Blog, Kategorien, Featured Images, RSS, Sitemap, JSON-LD, Docker und Coolify-Deployment in einer minimalistischen Schwarz-Weiß-Basis.
    </p>
    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <ButtonLink href="/blog/">Demo-Blog ansehen</ButtonLink>
      <ButtonLink href="/categories/" variant="outline">Kategorien ansehen</ButtonLink>
    </div>
  </Container>
</section>
