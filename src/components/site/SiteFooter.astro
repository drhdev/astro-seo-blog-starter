---
import { site } from "../../data/site";
---

<footer class="border-t border-border bg-muted/35">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 px-6 py-10 text-sm text-muted-foreground md:flex-row md:items-center md:justify-between lg:px-8">
    <p>&copy; {new Date().getFullYear()} {site.name}. Built with Astro.</p>
    <nav class="flex flex-wrap gap-5" aria-label="Footer navigation">
      {site.footer.map((item) => <a class="transition hover:text-foreground focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring" href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</footer>
