---
import { site } from "../../data/site";
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 px-6 py-10 text-sm text-slate-600 lg:px-8 md:flex-row md:items-center md:justify-between">
    <p>&copy; {new Date().getFullYear()} {site.name}. Built with Astro.</p>
    <nav class="flex flex-wrap gap-5" aria-label="Footer navigation">
      {site.footer.map((item) => <a class="hover:text-slate-950" href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</footer>
