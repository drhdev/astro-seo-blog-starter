---
import { site } from "../../data/site";
import ButtonLink from "../ui/ButtonLink.astro";
import ThemeToggle from "../theme/ThemeToggle.astro";
---

<header class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur supports-[backdrop-filter]:bg-background/75">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-6 py-4 lg:px-8">
    <a href="/" class="text-base font-semibold tracking-tight text-foreground" aria-label={`${site.name} Home`}>
      {site.name}
    </a>
    <nav class="hidden items-center gap-6 text-sm font-medium text-muted-foreground md:flex" aria-label="Primary navigation">
      {site.nav.map((item) => <a class="transition hover:text-foreground focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring" href={item.href}>{item.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <ThemeToggle />
      <ButtonLink href="/blog/" class="hidden md:inline-flex">Zum Blog</ButtonLink>
    </div>
  </div>
</header>
