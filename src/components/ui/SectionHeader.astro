---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div class="mx-auto max-w-3xl text-center">
  {eyebrow && <p class="text-sm font-medium uppercase tracking-[0.2em] text-muted-foreground">{eyebrow}</p>}
  <h2 class="mt-3 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">{title}</h2>
  {description && <p class="mt-5 text-lg leading-8 text-muted-foreground">{description}</p>}
</div>
