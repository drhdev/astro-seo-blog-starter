---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
---
<BaseLayout title="404" description="Die angefragte Seite wurde nicht gefunden." canonical="/404/" noindex={true}>
  <section class="py-24"><Container class="max-w-3xl text-center"><p class="font-semibold text-sky-700">404</p><h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950">Seite nicht gefunden</h1><p class="mt-6 text-lg text-slate-600">Die angefragte Seite existiert nicht oder wurde verschoben.</p><div class="mt-8"><ButtonLink href="/">Zur Startseite</ButtonLink></div></Container></section>
</BaseLayout>
