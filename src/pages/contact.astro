---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
---
<BaseLayout title="Kontakt" description="Kontaktinformationen für diese Website." canonical="/contact/">
  <section class="py-16 sm:py-24"><Container class="max-w-3xl"><h1 class="text-4xl font-semibold tracking-tight text-foreground">Kontakt</h1><p class="mt-6 text-lg leading-8 text-muted-foreground">Ersetze diese Platzhalterseite durch echte Kontaktinformationen, bevor du die Website veröffentlichst.</p></Container></section>
</BaseLayout>
