---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
---
<BaseLayout title="Impressum" description="Platzhalter für das Impressum. Vor Veröffentlichung rechtlich prüfen." canonical="/imprint/" noindex={true}>
  <section class="py-16 sm:py-24"><Container class="max-w-3xl"><h1 class="text-4xl font-semibold tracking-tight text-foreground">Impressum</h1><p class="mt-6 text-lg leading-8 text-muted-foreground">Platzhalter: Diese Seite muss vor einem Produktiv-Deployment durch eine qualifizierte Person geprüft und ersetzt werden.</p></Container></section>
</BaseLayout>
