---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
---
<BaseLayout title="Datenschutz" description="Platzhalter für die Datenschutzerklärung. Vor Veröffentlichung rechtlich prüfen." canonical="/privacy/" noindex={true}>
  <section class="py-16 sm:py-24"><Container class="max-w-3xl"><h1 class="text-4xl font-semibold tracking-tight text-slate-950">Datenschutz</h1><p class="mt-6 text-lg leading-8 text-slate-600">Platzhalter: Diese Seite muss vor einem Produktiv-Deployment durch eine qualifizierte Person geprüft und ersetzt werden.</p></Container></section>
</BaseLayout>
